# CEO助手 环境变量模板
# 复制为 .env 并填写真实值; 启动 uvicorn 前 export 或用 `env $(cat .env | xargs)` 加载
# 注意: 真实 .env 已在 .gitignore 中忽略, 不要提交

# ---- 飞书应用凭据 ----
# 在 飞书开放平台 -> 应用 -> 凭证与基础信息 中获取
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# ---- PostgreSQL 审计库连接串 ----
# 由 feishu-approval-ai 服务作为唯一写方维护 schema; 本服务只读
# 本地 docker 容器示例 (密码请替换为你容器内的实际密码):
CEO_AUDIT_DB_URL=postgresql+psycopg2://ceo_audit:YOUR_DB_PASSWORD@127.0.0.1:5433/ceo_audit
